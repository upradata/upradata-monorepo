{
    "name": "@upradata/browser-util",
    "version": "0.0.1",
    "description": "Library",
    "keywords": [
        "upradata"
    ],
    "license": "MIT",
    "author": "Upra-Data Contributors",
    "files": [
        "dist",
        "docs"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./create-event-in-raf": {
            "types": "./dist/create-event-in-raf.d.ts",
            "import": "./dist/create-event-in-raf.mjs",
            "require": "./dist/create-event-in-raf.cjs"
        },
        "./custom-events": {
            "types": "./dist/custom-events.d.ts",
            "import": "./dist/custom-events.mjs",
            "require": "./dist/custom-events.cjs"
        },
        "./services": {
            "types": "./dist/services/index.d.ts",
            "import": "./dist/services/index.mjs",
            "require": "./dist/services/index.cjs"
        },
        "./useful": {
            "types": "./dist/useful.d.ts",
            "import": "./dist/useful.mjs",
            "require": "./dist/useful.cjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "UPRADATA_PACK_MODE=production vp pack",
        "dev": "vp pack --watch",
        "docs": "typedoc src/index.ts --skipErrorChecking || true",
        "format": "turbo run format",
        "format:check": "vp fmt --write",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "test": "vp test run",
        "test:coverage": "vp test run --coverage",
        "typecheck": "vp check --no-fmt --no-lint"
    },
    "dependencies": {
        "@upradata/util": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@upradata/tsconfig": "workspace:*",
        "@upradata/vite-plus": "workspace:*"
    }
}
