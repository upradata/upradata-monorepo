{
  "name": "@upradata/rxjs",
  "version": "16.0.0",
  "description": "RxJS utilities for Upra-Data",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsup --config ../../configs/tsup/tsup-config.neutral.lib.ts --env.NODE_ENV production",
    "dev": "tsup --config ../../configs/tsup/tsup-config.neutral.lib.ts --watch --env.NODE_ENV development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "docs": "typedoc src/index.ts --skipErrorChecking || true"
},
  "keywords": [
    "upradata"
  ],
  "author": "Upra-Data Contributors",
  "license": "MIT",
  "dependencies": {
    "@upradata/util": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@upradata/tsconfig": "workspace:^"
  }
}
