{
    "name": "@upradata/webpack",
    "version": "1.0.0",
    "description": "utils for webpack as compiling webpack programmatically",
    "keywords": [
        "compile",
        "programmatically",
        "ts",
        "typescript",
        "upradata",
        "webpack"
    ],
    "license": "MIT",
    "author": {
        "name": "Thomas Milotti",
        "email": "thomas.milotti@gmail.com",
        "url": "https://github.com/milottit"
    },
    "repository": {
        "url": "https://github.com/upradata/util"
    },
    "files": [
        "dist",
        "docs"
    ],
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "UPRADATA_PACK_MODE=production vp pack",
        "dev": "vp pack --watch",
        "docs": "typedoc src/index.ts --skipErrorChecking || true",
        "format": "turbo run format",
        "format:check": "vp fmt --write",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "test": "vp test run",
        "test:coverage": "vp test run --coverage",
        "typecheck": "vp check --no-fmt --no-lint"
    },
    "dependencies": {
        "@upradata/node-util": "workspace:*",
        "@upradata/util": "workspace:*",
        "terser-webpack-plugin": "^5.6.1",
        "webpack": "^5.112.2"
    },
    "devDependencies": {
        "@types/babel__core": "^7.20.5"
    },
    "peerDependencies": {
        "@babel/core": "^8.0.9",
        "ts-loader": "^9.6.2",
        "tsconfig-paths-webpack-plugin": "^4.2.0"
    }
}
