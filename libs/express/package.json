{
    "name": "@upradata/express",
    "version": "4.0.3",
    "description": "Set of typescript util tools",
    "license": "MIT",
    "author": {
        "name": "Thomas Milotti",
        "email": "thomas.milotti@gmail.com",
        "url": "https://github.com/milottit"
    },
    "repository": {
        "url": "milottit@vs-ssh.visualstudio.com:v3/milottit/Util%20Typescript/Util%20Typescript"
    },
    "files": [
        "dist",
        "docs"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "UPRADATA_PACK_MODE=production vp pack",
        "dev": "vp pack --watch",
        "docs": "typedoc src/index.ts --skipErrorChecking || true",
        "format": "turbo run format",
        "format:check": "vp fmt --write",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "test": "vp test run",
        "test:coverage": "vp test run --coverage",
        "typecheck": "vp check --no-fmt --no-lint"
    },
    "dependencies": {
        "@google-cloud/debug-agent": "^9.0.1",
        "@sendgrid/client": "^8.1.6",
        "@sendgrid/mail": "^8.1.6",
        "@upradata/node-util": "workspace:*",
        "@upradata/util": "workspace:*",
        "body-parser": "^2.4.0",
        "cors": "^2.8.6",
        "express": "^5.3.0",
        "express-async-errors": "^3.1.1",
        "form-data": "^4.0.6",
        "mailgun.js": "^14.1.0",
        "serve-static": "^2.2.1"
    },
    "devDependencies": {
        "@types/body-parser": "^1.19.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-serve-static-core": "^5.1.3",
        "@types/node": "^26.6.5",
        "@types/qs": "^6.15.1",
        "@types/serve-static": "^2.2.0",
        "@upradata/tsconfig": "workspace:*",
        "@upradata/vite-plus": "workspace:*"
    }
}
