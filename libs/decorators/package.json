{
  "name": "@upradata/decorators",
  "version": "0.0.1",
  "description": "Library",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib-esm/index.js",
  "exports": {
    ".": {
      "import": "./lib-esm/index.js",
      "require": "./lib/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "lib-esm",
    "docs"
  ],
  "scripts": {
    "build": "rm -rf lib lib-esm && tsup src/index.ts src/**/*.ts --format cjs --outDir lib --clean && tsup src/index.ts src/**/*.ts --format esm --outDir lib-esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "docs": "typedoc src/index.ts --skipErrorChecking || true"
  },
  "keywords": [
    "upradata"
  ],
  "author": "Upra-Data Contributors",
  "license": "MIT",
  "dependencies": {
    "@angular/core": "^12.2.3",
    "@upradata/util": "workspace:*",
    "fixed-width-string": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "reflect-metadata": "^0.2.1"
  }
}
