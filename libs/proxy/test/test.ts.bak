const allConfig = {
    config: {
        a0: {
            b0: {
                c0: 1,
                c1: 'thomas'
            },
            b1: {
                c2: 2,
                c3: 'vincent'
            }
        },
        a1: {
            b2: {
                c4: 3,
                c5: 'roxane'
            },
            b3: {
                c6: 4,
                c7: 'miska'
            }
        }
    }
};



const proxyConfig = Proxy.createPartialExtra(allConfig, {
    setOption: {
        extendable: true,
        mutable: true
    },
    handler: {
                set: function (prop: Key, value: any) {
            this[ prop ] = value;
            console.log(`set: ${String(prop)} --> ${value}`);
            this[ prop ].changed$.next({ prop, value });
        }
    },
        changedUp: function (prop: Key, value: any) {
        console.log(`changed: ${String(prop)} --> ${value}`);
        this.changed$.next({ prop, value });
    },
    extra: {
        changed$: Extra.create(() => new ReplaySubject<PropValue>(1)),
        cc: 2
    }
});


proxyConfig.changed$.subscribe(({ prop, value }) => {
    console.log(`changed: ${String(prop)} --> ${value}`);
});


proxyConfig.config.a1.b3.changed$.subscribe(({ prop, value }) => {
    console.log(`changed: ${String(prop)} --> ${value}`);
});




proxyConfig.config.a1.b3 = { c6: 2 } as any;
proxyConfig.config.a0.b0.c0 = 111;

proxyConfig.config.$({ d: 1 });
(proxyConfig.config as any).d = { d1: 1 };



const proxyLiteral = Proxy.create(2);
console.log(proxyLiteral.$$);






const proxySetOption = Proxy.create({
    a: 1,
    b: 'thomas',
    c: { c1: 1 }
}, {
    setOption: {
        extendable: false,
        mutable: false
    }
});

console.log(proxySetOption.$$);

proxySetOption.a = 2;

(<any>proxySetOption).a = 'string'; // not mutable
(<any>proxySetOption).a = { a1: 1 }; // not mutable

(<any>proxySetOption).c = 3; // not mutable


console.log(proxySetOption.$$);

proxySetOption.a = undefined;
proxySetOption.c = undefined;

console.log(proxySetOption.$$);

proxySetOption.$({ d: 2 }); // not extendable

console.log(proxySetOption.$$);

interface TestObserver {
    a: number;
    b: {
        b1: string;
        b2: number;
    };
    c: string;
    d: {
        d1: number;
        d2: {
            d21: string;
        };
    };
}

const proxyObserver = ProxyObserver.create<TestObserver>(undefined, {
    setOption: {
        extendable: true,
        mutable: true
    },
});

const toObserve = {
    a: 1,
    b: {
        b1: 'tt',
        b2: 2
    },
    c: 'az',
    d: {
        d1: 123,
        d2: {
            d21: 'string'
        }
    }
};

proxyObserver.$(toObserve);
// proxyObserver = toObserve;

proxyObserver.b.changed$.subscribe(({ prop, value }) => {
    console.log(`${String(prop)} --> ${value}`, value);
});

proxyObserver.b.changed$.subscribe(({ prop, value }) => {
    console.log(`${String(prop)} --> ${value}`, value);
});

proxyObserver.d.changed$.subscribe(({ prop, value }) => {
    console.log(`${String(prop)} --> ${value}`, value);
});

proxyObserver.b.b1 = 'ela';
proxyObserver.d.d2 = { d21: 'caca' };

console.log(proxyObserver.$$);


const proxyArray = ProxyObserver.create({ a: [ 1, 2, 3 ] });
console.log(proxyArray.$$);


const cycle = { aiaa: 1 };
cycle[ 'b' ] = cycle;

const proxyCycle = Proxy.create(cycle);


interface CycleBase {
    a: number;
    b?: Cycle;
}

interface Cycle {
    c: number;
    d?: CycleBase;
}



const cycle2: CycleBase = {
    a: 1,
    b: {
        c: 2,
        d: undefined
    }
};

cycle2.b.d = cycle2;

const proxyCycle2 = Proxy.create(cycle2);

proxyCycle2.b.d.a = 7;
console.log(proxyCycle2.a.$$);

proxyCycle2.b.d = { a: 17 };
console.log(proxyCycle2.a.$$);


interface From {
    a: number;
}


const proxyFrom = ProxyObserver.create<From>({ a: 1 });
const proxyTo = proxyFrom.a.$map({
    fromTo: (v: number) => `${v}haha`,
    toFrom: (v: string) => parseInt(v, 10)

});


proxyFrom.a.changed$.subscribe(({ /* prop, */ value }) => {
    console.log(value);
    1 === 1;
});

proxyTo.changed$.subscribe(({ prop, value }) => {
    console.log(value);
    1 === 1;
});


proxyFrom.a = 7;
proxyTo.$('1234etvoila');


interface From2 {
    fa: number;
    fb: string;
}


interface To {
    ta: boolean;
    tb: number;
}

const proxyFrom2 = ProxyObserver.create<From2>();


const proxyTo2 = proxyFrom2.$map({
    fromTo: v => {
        return {
            ta: v.fa > 1,
            tb: v.fb.length
        };
    },
    toFrom: (v: To) => {
        return {
            fa: v.ta ? 1 : 2,
            fb: `length: ${v.tb}`
        };
    }

});



proxyTo2.changed$.subscribe(({ /* prop, */ value }) => {
    console.log(value);
    1 === 1;
});

proxyFrom2.changed$.subscribe(({ /* prop, */ value }) => {
    console.log(value);
    1 === 1;
});

proxyFrom2.$({ fa: 1, fb: 'string' });

proxyFrom2.fa = 7;
proxyFrom2.$({ fa: 1, fb: 'caca' });

proxyTo2.$({ ta: true });
proxyTo2.$({
    ta: false,
    tb: 12345
});

1 === 1;
