/* eslint-disable object-shorthand */
import { ReplaySubject } from 'rxjs';
import { Key } from '@upradata/util';
import { Proxy, ProxyObserver } from '../src/proxy';
// import { ProxyHandler } from '../src/node';
import { Extra } from '../src/node/extra';


interface Normal {
    a: number;
    b: {
        b1: number;
        b2?: string;
    };
    c?: {
        c1: number;
    };
}

const normalTest = ProxyObserver.create<Normal>(undefined, { setOption: { extendable: true, mutable: false } });
normalTest.$({
    a: 1,
    b: { b1: 2, b2: 'Hahaha' },
    c: { c1: 3 }
});

console.log(normalTest.$$);

const { b } = normalTest;

normalTest.c.c1 = 11;

b.$({ b1: 20 });

console.log(normalTest.$$);

const normalTest2 = ProxyObserver.create<Normal>(undefined, { setOption: { extendable: true, mutable: false } });
normalTest2.$({
    a: undefined,
    b: undefined
});

normalTest2.a = 1;
normalTest2.b = { b1: 2 };
normalTest2.b.$({ b2: 'haha' });

console.log(normalTest2.$$);




const normalTest3 = ProxyObserver.create<Normal>(undefined, { setOption: { extendable: true, mutable: false } });
normalTest3.$({
    a: 1,
    b: { b1: 2, b2: 'Hahaha' }
});
normalTest3.$({
    c: { c1: 3 }
});

console.log(normalTest3.$$);


const pppp = Proxy.create().$(2);
console.log(pppp.$$);

const success = ProxyObserver.create({ a: 1 }, { setOption: { extendable: false, mutable: false } });

success.changed$.subscribe(({ prop, value }) => {
    console.log(`${String(prop)}: ${value}`);
});

success.$({ b: 2 });
success.a = 'pas bon' as any;

const ccc = {
    a: 2,
    b: {
        a2: 9,
        b2: 'vincent'
    },
    c: 'thomas'
};


interface PropValue {
    prop: Key;
    value: any;
}


const changed$ = new ReplaySubject<PropValue>(1);

changed$.subscribe(e => {
    console.log('observer', e.prop, e.value);
});

let first = true;

const p3 = Proxy.create(ccc,
    {
        setOption: {
            extendable: true,
            mutable: true
        },
        handler: {
                        set: function (prop: Key, value: any) {
                console.log('CACACAA');
                let v = value;

                if (prop === 'b' && first) {
                    v = {
                        b2: 'ROXANE :)',
                        d: {
                            d1: 1,
                            d2: 2
                        }
                    };
                } else {
                    v = value;
                }

                console.log('BEFORE', prop, v, '\n');
                changed$.next({ prop, value: v });

                this[ prop ] = v;

                console.log('AFTER', prop, v, '\n');
                changed$.next({ prop, value: v });
            }
        }
    });


// const p4 = p3 as any as Proxy;

console.log('Proxy');
// p4.set(ccc); // init

first = false;


console.log('p3.a', p3.a);
console.log('p3.b', p3.b.$$);
console.log('p3.b.a2', p3.b.a2);
console.log('p3.b.b2', p3.b.b2);
console.log('p3.b.d', (p3.b as any).d.$$);
console.log('p3.c', p3.c.$$);

console.log('\n\n\n\n\n Nouveau');

p3.b = { a2: 17 } as any;
console.log('p3.b', p3.b.$$);


console.log('\n\n\n\n\n Nouveau');

((p3.b) as any).d = { d2: 1234 } as any;
console.log('p3.b.d', ((p3.b) as any).d);


