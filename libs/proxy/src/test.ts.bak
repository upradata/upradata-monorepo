type Cycle = { a: number; b: { c: number; d: Cycle; }; };

const cycleTarget: Cycle = { a: 1, b: { c: 2, d: undefined } };
cycleTarget.b.d = cycleTarget;

try {
    const proxy = Proxy.create(cycleTarget);
} catch (e) {
    console.log(e);
}

