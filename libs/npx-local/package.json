{
    "name": "@upradata/npx-local",
    "version": "3.5.12",
    "description": "Npm/Pnpm/Yarn Local Packages Install",
    "author": "Thomas Milotti <thomas.milotti@gmail.com> (https://github.com/milottit)",
    "license": "MIT",
    "files": [
        "dist",
        "docs"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "bin": {
        "npx-local": "./dist/index.cjs"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "UPRADATA_PACK_MODE=production vp pack",
        "dev": "vp pack --watch",
        "docs": "typedoc src/index.ts --skipErrorChecking || true",
        "format": "turbo run format",
        "format:check": "vp fmt --write",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "test": "vp test run",
        "test:coverage": "vp test run --coverage",
        "typecheck": "vp check --no-fmt --no-lint"
    },
    "dependencies": {
        "@upradata/dependency-injection": "workspace:*",
        "@upradata/node-util": "workspace:*",
        "@upradata/util": "workspace:*",
        "fs-extra": "^11.4.1",
        "node-watch": "^0.7.4",
        "shelljs": "^0.10.0",
        "shelljs-live": "^0.0.5"
    },
    "devDependencies": {
        "@schemastore/package": "1.0.5",
        "@types/fs-extra": "^11.0.4",
        "@types/shelljs": "^0.10.0",
        "@upradata/tsconfig": "workspace:*",
        "@upradata/vite-plus": "workspace:*"
    }
}
