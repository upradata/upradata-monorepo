{
    "name": "@upradata/require-override",
    "version": "1.0.3",
    "description": "Small lib to override Module._load when a module is \"require\"d.",
    "license": "MIT",
    "author": "Thomas Milotti <thomas.milotti@gmail.com> (https://github.com/milottit)",
    "files": [
        "dist",
        "docs"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "UPRADATA_PACK_MODE=production vp pack",
        "dev": "vp pack --watch",
        "docs": "typedoc src/index.ts --skipErrorChecking || true",
        "format": "turbo run format",
        "format:check": "vp fmt --write",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "test": "vp test run",
        "test:coverage": "vp test run --coverage",
        "typecheck": "vp check --no-fmt --no-lint"
    },
    "dependencies": {
        "get-caller-file": "^2.0.5",
        "normalize-path": "^3.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.5.4",
        "@types/normalize-path": "^3.0.2",
        "@upradata/tsconfig": "workspace:*",
        "@upradata/vite-plus": "workspace:*",
        "concurrently": "^8.2.2",
        "typescript": "^5.5.4"
    },
    "packageManager": "pnpm@9.9.0+sha512.60c18acd138bff695d339be6ad13f7e936eea6745660d4cc4a776d5247c540d0edee1a563695c183a66eb917ef88f2b4feb1fc25f32a7adcadc7aaf3438e99c1",
    "esm": {
        "mainFields": [
            "module",
            "main"
        ]
    },
    "local": {
        "usedBy": {
            "@upradata/tilda-tools": "/home/milottit/Libraries/Tilda/tools"
        }
    }
}
