{
    "name": "@upradata/dependency-injection",
    "version": "0.0.1",
    "description": "Library",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./decorators": {
            "types": "./dist/decorators/index.d.ts",
            "import": "./dist/decorators/index.js",
            "require": "./dist/decorators/index.cjs"
        },
        "./di-injector": {
            "types": "./dist/di-injector.d.ts",
            "import": "./dist/di-injector.js",
            "require": "./dist/di-injector.cjs"
        },
        "./injector": {
            "types": "./dist/injector.d.ts",
            "import": "./dist/injector.js",
            "require": "./dist/injector.cjs"
        },
        "./injector.app": {
            "types": "./dist/injector.app.d.ts",
            "import": "./dist/injector.app.js",
            "require": "./dist/injector.app.cjs"
        },
        "./provider": {
            "types": "./dist/provider.d.ts",
            "import": "./dist/provider.js",
            "require": "./dist/provider.cjs"
        },
        "./token": {
            "types": "./dist/token.d.ts",
            "import": "./dist/token.js",
            "require": "./dist/token.cjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [ "dist", "docs" ],
    "scripts": {
        "build": "tsup --config ../../configs/tsup/tsup-config.neutral.lib.ts --env.NODE_ENV production",
        "dev": "tsup --config ../../configs/tsup/tsup-config.neutral.lib.ts --watch --env.NODE_ENV development",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "biome lint src",
        "lint:fix": "biome lint --write src",
        "docs": "typedoc src/index.ts --skipErrorChecking || true"
    },
    "keywords": [ "upradata" ],
    "author": "Upra-Data Contributors",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@upradata/tsconfig": "workspace:^"
    }
}
