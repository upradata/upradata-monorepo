{
    "name": "@upradata/stream",
    "version": "16.0.0",
    "description": "Node.js stream utilities for Upra-Data",
    "keywords": [
        "upradata"
    ],
    "license": "MIT",
    "author": "Upra-Data Contributors",
    "files": [
        "dist",
        "docs"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "UPRADATA_PACK_MODE=production vp pack",
        "dev": "vp pack --watch",
        "docs": "typedoc src/index.ts --skipErrorChecking || true",
        "format": "turbo run format",
        "format:check": "vp fmt --write",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "test": "vp test run",
        "test:coverage": "vp test run --coverage",
        "typecheck": "vp check --no-fmt --no-lint"
    },
    "dependencies": {
        "@upradata/util": "workspace:*",
        "duplexify": "^4.1.3",
        "gulp-if": "^3.0.0",
        "lead": "^4.0.0",
        "merge2": "^1.4.1",
        "minimatch": "^10.2.6",
        "plugin-error": "^2.0.1",
        "through2": "^5.0.12",
        "tsconfig": "^7.0.0",
        "vinyl": "^3.0.1"
    },
    "devDependencies": {
        "@upradata/tsconfig": "workspace:*",
        "@upradata/vite-plus": "workspace:*"
    }
}
