{
    "name": "@upradata/stream",
    "version": "16.0.0",
    "description": "Node.js stream utilities for Upra-Data",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [ "dist", "docs" ],
    "scripts": {
        "build": "tsup --config ../../configs/tsup/tsup-config.node.lib.ts --env.NODE_ENV production",
        "dev": "tsup --config ../../configs/tsup/tsup-config.node.lib.ts --watch --env.NODE_ENV development",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "biome lint src",
        "lint:fix": "biome lint --write src",
        "docs": "typedoc src/index.ts --skipErrorChecking || true"
    },
    "keywords": [ "upradata" ],
    "author": "Upra-Data Contributors",
    "license": "MIT",
    "dependencies": {
        "@upradata/util": "workspace:*",
        "duplexify": "^4.1.2",
        "gulp-if": "^3.0.0",
        "lead": "^3.0.0",
        "merge2": "^1.4.1",
        "minimatch": "^9.0.5",
        "plugin-error": "^1.0.1",
        "through2": "^4.0.2",
        "tsconfig": "^7.0.0",
        "vinyl": "^2.2.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@upradata/tsconfig": "workspace:^"
    }
}
