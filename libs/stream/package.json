{
  "name": "@upradata/stream",
  "version": "0.0.1",
  "description": "Library",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib-esm/index.js",
  "exports": {
    ".": {
      "import": "./lib-esm/index.js",
      "require": "./lib/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "lib-esm",
    "docs"
  ],
  "scripts": {
    "build": "rm -rf lib lib-esm && tsup src/index.ts --format cjs --outDir lib --clean && tsup src/index.ts --format esm --outDir lib-esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "docs": "typedoc src/index.ts --skipErrorChecking || true"
  },
  "keywords": [
    "upradata"
  ],
  "author": "Upra-Data Contributors",
  "license": "MIT",
  "dependencies": {
    "@upradata/util": "workspace:*",
    "duplexify": "^4.1.2",
    "gulp-if": "^3.0.0",
    "lead": "^3.0.0",
    "merge2": "^1.4.1",
    "minimatch": "^9.0.5",
    "plugin-error": "^1.0.1",
    "through2": "^4.0.2",
    "tsconfig": "^7.0.0",
    "vinyl": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
