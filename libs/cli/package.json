{
    "name": "@upradata/cli",
    "version": "1.0.0",
    "description": "Dependency-free CLI framework with coloured help and an interactive mode",
    "keywords": [
        "cli",
        "interactive",
        "upradata"
    ],
    "license": "MIT",
    "author": {
        "name": "Upra-Data",
        "email": "code@upradata.com",
        "url": "https://github.com/upradata"
    },
    "files": [
        "dist",
        "docs"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "UPRADATA_PACK_MODE=production vp pack",
        "dev": "vp pack --watch",
        "docs": "typedoc src/index.ts --skipErrorChecking || true",
        "format": "turbo run format",
        "format:check": "vp fmt --write",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "test": "vp test run",
        "test:coverage": "vp test run --coverage",
        "typecheck": "vp check --no-fmt --no-lint"
    },
    "devDependencies": {
        "@clack/prompts": "^0.11.0",
        "@types/node": "^26.6.5",
        "@upradata/tsconfig": "workspace:*",
        "@upradata/vite-plus": "workspace:*"
    },
    "peerDependencies": {
        "@clack/prompts": "^0.11.0"
    },
    "peerDependenciesMeta": {
        "@clack/prompts": {
            "optional": true
        }
    }
}
