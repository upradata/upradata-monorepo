{
    "name": "@upradata/stencil",
    "version": "1.0.0",
    "description": "Stencil utilities for Upra-Data",
    "keywords": [
        "stencil",
        "upradata",
        "web-components"
    ],
    "license": "MIT",
    "author": "Upra-Data Contributors",
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/index.cjs.js"
            }
        },
        "./components": {
            "import": {
                "default": "./dist/components/index.js",
                "types": "./dist/types/components/index.d.ts"
            }
        },
        "./util": {
            "import": {
                "default": "./dist/collection/index.js"
            },
            "require": {
                "types": "./dist/types/util/index.d.ts",
                "default": "./dist/util/index.cjs.js"
            }
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm run build:stencil && pnpm run build:lib",
        "build:lib": "UPRADATA_PACK_MODE=production vp pack",
        "build:stencil": "stencil build --docs",
        "dev": "stencil build --dev --watch --serve",
        "docs": "typedoc src/index.ts --skipErrorChecking || true",
        "format": "turbo run format",
        "format:check": "vp fmt --write",
        "generate": "stencil generate",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "test": "vp test run",
        "test:coverage": "vp test run --coverage",
        "test:lib:unit": "stencil-test --project lib:unit",
        "test:stencil:unit": "stencil-test --project stencil:unit",
        "test:watch": "stencil-test --watch",
        "typecheck": "vp check --no-fmt --no-lint"
    },
    "dependencies": {
        "@stencil/core": "^4.45.2",
        "@stencil/store": "^2.2.5",
        "@upradata/util": "workspace:*"
    },
    "devDependencies": {
        "@stencil/vitest": "^1.16.1",
        "@upradata/tsconfig": "workspace:*",
        "@upradata/vite-plus": "workspace:*"
    }
}
