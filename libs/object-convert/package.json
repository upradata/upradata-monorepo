{
    "name": "@upradata/object-convert",
    "version": "3.0.1",
    "description": "Convert Js object with transformers",
    "keywords": [
        "javascript",
        "json",
        "parser",
        "typescript"
    ],
    "license": "ISC",
    "author": {
        "name": "Thomas Milotti",
        "email": "thomas.milotti@gmail.com",
        "url": "https://github.com/milottit"
    },
    "repository": {
        "url": "https://github.com/upradata/object-converter"
    },
    "files": [
        "dist",
        "docs"
    ],
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "UPRADATA_PACK_MODE=production vp pack",
        "dev": "vp pack --watch",
        "docs": "typedoc src/index.ts --skipErrorChecking || true",
        "format": "turbo run format",
        "format:check": "vp fmt --write",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "test": "vp test run",
        "test:coverage": "vp test run --coverage",
        "typecheck": "vp check --no-fmt --no-lint"
    },
    "dependencies": {
        "@upradata/util": "workspace:*",
        "colors": "^1.4.0",
        "common-tags": "^1.8.2",
        "is-check": "^1.0.2",
        "reflect-metadata": "^0.1.13"
    },
    "devDependencies": {
        "@types/jest": "^28.1.3",
        "@types/node": "^18.0.0",
        "@upradata/tsconfig": "workspace:*",
        "@upradata/vite-plus": "workspace:*",
        "concurrently": "^7.2.2",
        "emoji-datasource": "^14.0.0",
        "fs-extra": "^10.1.0",
        "jest": "^28.1.1",
        "jest-environment-node": "^28.1.1",
        "ts-jest": "^28.0.5",
        "ts-node": "^10.8.1",
        "typescript": "^4.7.4"
    },
    "local": {
        "dependencies": {
            "@upradata/util": "link:/home/milottit/Libraries/Upra-Data/util@13.0.1"
        }
    }
}
