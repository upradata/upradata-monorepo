{
    "name": "@upradata/object-convert",
    "version": "3.0.1",
    "description": "Convert Js object with transformers",
    "keywords": [
        "javascript",
        "json",
        "parser",
        "typescript"
    ],
    "license": "ISC",
    "author": {
        "name": "Thomas Milotti",
        "email": "thomas.milotti@gmail.com",
        "url": "https://github.com/milottit"
    },
    "repository": {
        "url": "https://github.com/upradata/object-converter"
    },
    "files": [
        "dist",
        "docs"
    ],
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "UPRADATA_PACK_MODE=production vp pack",
        "dev": "vp pack --watch",
        "docs": "typedoc src/index.ts --skipErrorChecking || true",
        "format": "turbo run format",
        "format:check": "vp fmt --write",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "test": "vp test run",
        "test:coverage": "vp test run --coverage",
        "typecheck": "vp check --no-fmt --no-lint"
    },
    "dependencies": {
        "@upradata/util": "workspace:*"
    },
    "devDependencies": {
        "@upradata/tsconfig": "workspace:*",
        "@upradata/vite-plus": "workspace:*",
        "emoji-datasource": "^16.0.0",
        "fs-extra": "^11.4.1"
    }
}
