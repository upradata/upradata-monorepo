{
    "name": "@upradata/npx-init",
    "version": "4.0.1",
    "description": "Customized and enhanced npm init script",
    "license": "MIT",
    "author": {
        "name": "Thomas Milotti",
        "email": "thomas.milotti@gmail.com",
        "url": "https://github.com/milottit"
    },
    "repository": {
        "url": "https://github.com/upradata/npx-init"
    },
    "bin": {
        "npx-init": "./dist/run.cjs"
    },
    "files": [
        "dist",
        "docs"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "UPRADATA_PACK_MODE=production vp pack",
        "dev": "vp pack --watch",
        "docs": "typedoc src/index.ts --skipErrorChecking || true",
        "format": "turbo run format",
        "format:check": "vp fmt --write",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "test": "vp test run",
        "test:coverage": "vp test run --coverage",
        "typecheck": "vp check --no-fmt --no-lint"
    },
    "dependencies": {
        "@upradata/node-util": "workspace:*",
        "fs-extra": "^11.4.1",
        "ini": "^7.0.0",
        "npm-package-arg": "^14.0.0",
        "prompts": "^2.4.2",
        "semver": "^7.8.5",
        "validate-npm-package-license": "^3.0.4",
        "validate-npm-package-name": "^8.0.0"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/ini": "^4.1.1",
        "@types/npm-package-arg": "^6.1.4",
        "@types/prompts": "^2.4.9",
        "@types/semver": "^7.8.0",
        "@types/validate-npm-package-license": "^3.0.3",
        "@types/validate-npm-package-name": "^4.0.2",
        "@upradata/tsconfig": "workspace:*",
        "@upradata/vite-plus": "workspace:*"
    }
}
