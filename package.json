{
    "name": "upra-data-monorepo",
    "version": "0.0.1",
    "private": true,
    "description": "Upra-Data libraries and applications monorepo",
    "packageManager": "pnpm@9.1.0",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": "^9.0.0"
    },
    "scripts": {
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "build": "turbo run build",
        "clean": "turbo run clean && rm -rf node_modules",
        "dev": "turbo run dev --parallel",
        "format": "biome format --write .",
        "format:check": "biome format --check .",
        "docs": "turbo run docs && tsx scripts/generate-docs-index.ts",
        "docs:serve": "python3 -m http.server 8000 --directory docs",
        "changeset": "changeset",
        "version": "changeset version",
        "publish": "turbo run build && changeset publish"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.2",
        "@changesets/cli": "^3.0.3",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@typescript/typescript6": "^6.0.2",
        "eslint": "^10.13.0",
        "husky": "^9.1.7",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "turbo": "^2.11.10",
        "typedoc": "^0.28.20",
        "typedoc-plugin-missing-exports": "^4.1.4",
        "typedoc-plugin-rename-defaults": "^0.7.3",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
