{
    "include": [
        "**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "build",
        "coverage",
        "libs",
        "apps",
        "docs",
        "**/.*"
    ],
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./no-output-as-it-is-just-for-the-ide",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "node",
            "vitest/globals"
        ]
    }
}